{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "fractional-hr-site",
  "compatibility_date": "2025-05-05",
  "keep_vars": true,
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "D1_SYSTEM_EVENTS_MODE": "off",
    "D1_DIAGNOSTIC_SUBMISSIONS_MODE": "off",
    "D1_CRM_PROSPECTS_MODE": "off",
    "D1_CLIENT_DIAGNOSTIC_MODE": "off",
    "D1_CLIENT_DIAGNOSTIC_SECURITY_MODE": "off"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fractional-hr-site"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vanesch-prod",
      "database_id": "b81b99d7-4b10-4f7e-a0c1-ada3adf596fc"
    }
  ],
  "env": {
    "qa": {
      "vars": {
        "D1_SYSTEM_EVENTS_MODE": "shadow",
        "D1_DIAGNOSTIC_SUBMISSIONS_MODE": "off",
        "D1_CRM_PROSPECTS_MODE": "shadow",
        "D1_CLIENT_DIAGNOSTIC_MODE": "off",
        "D1_CLIENT_DIAGNOSTIC_SECURITY_MODE": "off"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "fractional-hr-site-qa"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vanesch-qa",
          "database_id": "b25d59da-5f93-4301-9996-7be0c9708789"
        }
      ]
    }
  }
}
